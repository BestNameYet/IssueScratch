{
  "schema": "issuescratch.stateless-services.v2",
  "services": {
    "router_validator": {
      "host": "0.0.0.0",
      "port": 8787
    },
    "router": {
      "host": "127.0.0.1",
      "port": 8786
    },
    "fsm": {
      "host": "127.0.0.1",
      "port": 8788
    },
    "renderer": {
      "host": "127.0.0.1",
      "port": 8789
    },
    "validation": {
      "host": "127.0.0.1",
      "port": 8790
    }
  },
  "timeout_ms": 30000,
  "routes": [
    {
      "method": "POST",
      "path": "/transition",
      "service": "validation",
      "upstream_path": "/transition"
    },
    {
      "method": "POST",
      "path": "/validate",
      "service": "validation",
      "upstream_path": "/validate"
    },
    {
      "method": "POST",
      "path": "/render",
      "service": "renderer",
      "upstream_path": "/render",
      "allowed_modes": [
        "procedure",
        "input-error",
        "fsm-diagnostic",
        "state-file",
        "validation-result",
        "router-input-error",
        "router-service-error"
      ]
    }
  ],
  "renderer_settings": {
    "modes": {
      "procedure": {
        "format": "json",
        "destination": "agent-issue"
      },
      "input-error": {
        "format": "json",
        "destination": "agent-issue"
      },
      "fsm-diagnostic": {
        "format": "jsonl",
        "destination": "fsm-log"
      },
      "state-file": {
        "format": "json",
        "destination": "state-file"
      },
      "validation-result": {
        "format": "json",
        "destination": "agent-issue"
      },
      "router-input-error": {
        "format": "json",
        "destination": "agent-issue"
      },
      "router-service-error": {
        "format": "jsonl",
        "destination": "fsm-log"
      }
    },
    "destinations": {
      "agent-issue": {
        "adapter": "github-issue",
        "issue_number": 1
      },
      "fsm-log": {
        "adapter": "file-append",
        "path": "/runtime/output/fsm-log.jsonl"
      },
      "state-file": {
        "adapter": "file-replace",
        "path": "/runtime/output/state.json"
      }
    }
  },
  "service_port_lookup": {
    "router_validator": 8787,
    "router": 8786,
    "fsm": 8788,
    "renderer": 8789,
    "validation": 8790
  }
}
